datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Destinasi {
  id        Int      @id @default(autoincrement())
  nama      String
  kategori  String
  hargaTiket Int
  
  // Masukkan relasi jika ada (misal: Ulasan atau Fasilitas)
}